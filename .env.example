# ============================================================
# FB Marketplace Tracker - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it is already in .gitignore.
# ============================================================

# Session secret (generate a strong random string)
SESSION_SECRET=your_session_secret_here

# AI / OpenAI Integration
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API key (used for screenshot analysis via Claude vision)
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Facebook credentials
FACEBOOK_EMAIL=your_facebook_email@example.com
FACEBOOK_PASSWORD=your_facebook_password_here
FACEBOOK_COOKIES=your_facebook_cookies_json_here

# AccuTrade credentials
ACCUTRADE_EMAIL=your_accutrade_email@example.com
ACCUTRADE_PASSWORD=your_accutrade_password_here

# API keys
APIFY_API_KEY=your_apify_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
