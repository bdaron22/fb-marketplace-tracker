# AutoScout Environment Variables
# Copy this file to .env.local and fill in your values

# Anthropic Claude API Key (https://console.anthropic.com)
VITE_ANTHROPIC_API_KEY=sk-ant-...

# Apify API Token (https://console.apify.com/account/integrations)
VITE_APIFY_TOKEN=apify_api_...

# PocketBase URL (self-hosted or https://pocketbase.io)
# Leave blank to use localStorage only
VITE_POCKETBASE_URL=http://127.0.0.1:8090

# AccuTrade API (requires dealer account - https://www.accutrade.com)
# Leave blank to use the estimate calculator
VITE_ACCUTRADE_API_KEY=
