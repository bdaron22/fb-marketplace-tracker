# T1000 Environment Variables
# Copy this file to .env and fill in your values
# (Frontend keys can also be entered in the Settings page instead)

# ── Frontend (Vite) ──────────────────────────────────────────────────────────

# Anthropic Claude API Key (https://console.anthropic.com)
VITE_ANTHROPIC_API_KEY=sk-ant-...

# Apify API Token — used by frontend fallback if server isn't running
# Prefer setting APIFY_API_KEY below so the key stays server-side
VITE_APIFY_TOKEN=apify_api_...

# PocketBase URL (self-hosted or https://pocketbase.io)
# Leave blank to use localStorage only
VITE_POCKETBASE_URL=http://127.0.0.1:8090

# AccuTrade dealer login (https://appraiser3.accu-trade.com)
VITE_ACCUTRADE_EMAIL=
VITE_ACCUTRADE_PASSWORD=

# ── Server (Express — npm start / npm run server) ────────────────────────────

# Apify API Key — kept server-side, never sent to the browser
APIFY_API_KEY=apify_api_...

# Optional: override the default Apify actor for FB Marketplace scraping
# Default: maxcopell~facebook-marketplace
# APIFY_ACTOR_ID=maxcopell~facebook-marketplace

# Optional: Facebook credentials for Apify to log in (gets more listings)
FACEBOOK_EMAIL=
FACEBOOK_PASSWORD=

# Port for the Express API server (default: 3001)
# API_PORT=3001
