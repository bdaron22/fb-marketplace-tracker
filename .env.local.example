# Copy this file to .env.local and fill in your keys

# Apify - get from https://console.apify.com/account/integrations
APIFY_TOKEN=your_apify_token_here

# Anthropic Claude API - get from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# AccuTrade API - contact AccuTrade for dealer API access
ACCUTRADE_API_KEY=your_accutrade_api_key_here
ACCUTRADE_API_URL=https://api.accutrade.com/v1

# Frontend env (exposed to browser - only safe public values)
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here
